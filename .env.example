# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file. Placeholders only — no real secrets.

# --- Required for production ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (React frontend origins) ---
# Development defaults below. For production, replace with your deployed React URL:
# CORS_ALLOWED_ORIGINS=https://YOUR-REACT-FRONTEND-DOMAIN
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# Optional: trusted HTTPS origins for Django admin CSRF (comma-separated).
# CSRF_TRUSTED_ORIGINS=https://YOUR-API-DOMAIN

# --- Database ---
# Local development uses SQLite automatically when DATABASE_URL / DB_ENGINE are unset.
# Option A — connection URL (common on PaaS hosts):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME
# Option B — discrete variables:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=calculator
# DB_USER=calculator
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# PostgreSQL driver (psycopg[binary]) is included in requirements.txt.

# --- HTTPS hardening (applied when DJANGO_DEBUG=False) ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=False
